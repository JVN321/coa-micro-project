# ── Ripes Executable Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in the correct path for your system.
#
# Linux example:
#   RIPES_EXE="/home/user/Ripes-v2.2.6-linux-x86_64/Ripes"
#
# Windows example:
#   RIPES_EXE="C:\Ripes-v2.2.6-77-g4981e31-win-x86_64\Ripes.exe"

RIPES_EXE=

# ── Ripes Processor Configuration ────────────────────────────────────────────
# Specify the processor to use.
# Use "RV32_5S" for the 5-stage pipeline with forwarding (default).
# Use "RV32_5S_NO_FW" for the 5-stage pipeline without forwarding.
#
# RIPES_PROC="RV32_5S"
